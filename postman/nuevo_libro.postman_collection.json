{
  "info": {
    "name": "Biblo - Nuevo Libro",
    "description": "Prueba de la ruta POST para crear un libro nuevo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Crear nuevo libro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"El Aleph\",\n  \"descripcion\": \"Colección de cuentos de Jorge Luis Borges.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/app/bibilo/nuevo_libro",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["app", "bibilo", "nuevo_libro"]
        },
        "description": "Crea un libro en la base de datos. Requiere `nombre` y `descripcion` en el body."
      },
      "response": []
    },
    {
      "name": "Crear nuevo libro (error - sin nombre)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Solo descripción, sin nombre.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/app/bibilo/nuevo_libro",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["app", "bibilo", "nuevo_libro"]
        },
        "description": "Prueba de validación: debería fallar porque falta `nombre`."
      },
      "response": []
    }
  ]
}
